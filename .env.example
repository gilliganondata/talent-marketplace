# Copy the variable names below into Netlify's environment variables UI
# (Project configuration → Environment variables). Do not put real values
# in this file, or commit a copy of this file with real values filled in —
# it exists purely as a reference of what's needed and where to get it.

# Supabase project URL (Connect dialog) — safe to expose, not secret
SUPABASE_URL=

# Supabase secret key (Connect dialog) — SECRET. Server-side only.
SUPABASE_SECRET_KEY=

# Resend API key, created with "Sending access" only — SECRET.
RESEND_API_KEY=

# The email address that should receive new-submission notifications
NOTIFY_EMAIL=

# Your live site URL, e.g. https://your-site.netlify.app
SITE_URL=

# A random string used to verify Supabase webhook calls are genuine.
# Generate one with: openssl rand -hex 32 — SECRET.
WEBHOOK_SECRET=